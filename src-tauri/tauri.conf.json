{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote HTTP Action",
  "mainBinaryName": "remote-http-action",
  "version": "1.0.0",
  "identifier": "com.remotehttpaction.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Remote HTTP Action",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "remote-http-action contributors",
    "copyright": "© 2026 remote-http-action contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "HTTP server for running predefined actions on a Windows computer",
    "longDescription": "Remote HTTP Action keeps an HTTP(S) server running and executes configured flows — shutdown, sleep, commands, scripts, application launches — on authorized requests with API keys.",
    "windows": {
      "wix": {
        "language": [
          "ru-RU",
          "en-US"
        ],
        "upgradeCode": "6BF27B3C-7CC1-47BB-9B9E-F9EBDF14FD19"
      }
    }
  }
}
